# Listens on all interfaces (LAN / Tailscale) by default; the token guards access. Use 127.0.0.1 for this machine only.
BRIDGE_DASHBOARD_HOST=0.0.0.0
# Port is fixed at 4317; override with the PORT env var (e.g. PORT=5000 npm run dev).
# Required. Long random string; enter it once per device on the login screen.
BRIDGE_DASHBOARD_TOKEN=
# Defaults to nats://localhost:4222 (same as the agents).
BRIDGE_NATS_URL=
# Where history.jsonl and messages.sqlite are kept. Defaults to ~/.bridge-harness
BRIDGE_DASHBOARD_DATA=
# Command that launches spawned Pi agents; the startup prompt is appended (default "pi-profile nats").
BRIDGE_DASHBOARD_PI_CMD=
# Days of messages kept in messages.sqlite (default 30).
BRIDGE_DASHBOARD_RETENTION_DAYS=
# "all" (default) records every DM and room on this NATS; "self" only the dashboard's own.
# Use "self" on a NATS shared with other people.
BRIDGE_DASHBOARD_WATCH=
# Stable bridge id; defaults to dashboard-<hostname>.
BRIDGE_DASHBOARD_ID=
PLT_SERVER_LOGGER_LEVEL=info
