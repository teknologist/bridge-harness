{
  "name": "@cocodrino/bridge-harness",
  "version": "0.3.50",
  "description": "Real-time NATS bridge for AI agent communication — connects Claude Code and Pi with zero user intervention",
  "type": "module",
  "author": "cocodrino",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/cocodrino/bridge-harness.git"
  },
  "homepage": "https://github.com/cocodrino/bridge-harness#readme",
  "keywords": [
    "ai-agents",
    "claude-code",
    "pi-agent",
    "nats",
    "mcp",
    "multi-agent",
    "bridge"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "bin": {
    "bridge-harness": "./dist/cli/index.js",
    "bridge-harness-mcp": "./dist/mcp-server/index.js",
    "bridge-harness-setup": "./dist/setup/index.js",
    "bridge-harness-skills": "./dist/install-skills/index.js",
    "bridge-rewake": "./hooks/bridge-rewake.js"
  },
  "exports": {
    ".": "./dist/index.js",
    "./nats-manager": "./dist/nats-manager/index.js",
    "./shared": "./dist/shared/index.js"
  },
  "files": [
    "dist/",
    "hooks/",
    "skills/",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc",
    "build:mod": "esbuild packages/bridge-harness-claude-mod/helper/bridge-tap.src.mjs --bundle --platform=node --format=esm --target=node18 --minify --tsconfig-raw={} \"--banner:js=import{createRequire}from'node:module';const require=createRequire(import.meta.url);\" --outfile=packages/bridge-harness-claude-mod/helper/bridge-tap.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && npm --prefix packages/bridge-harness-pi run typecheck",
    "test:watch": "vitest",
    "prepare": "node scripts/prepare.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "nats": "^2.29.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "esbuild": "^0.27.7",
    "typescript": "^5.7.0",
    "vitest": "^3.2.0"
  },
  "pi": {
    "extensions": [
      "./packages/bridge-harness-pi/src/index.ts"
    ],
    "skills": [
      "./packages/bridge-harness-pi/skills"
    ]
  }
}
